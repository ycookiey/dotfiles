# グローバル gitattributes。setup.ps1 が ~/.gitattributes として link し、git/.gitconfig の core.attributesFile で読ませる
# repo の .gitattributes より優先度が低い。repo が .gitattributes を持っていても、repo 側が指定していない属性にはこちらが効く

# テキスト/バイナリを自動検出し、リポジトリ内は LF で統一
* text=auto

# シェルスクリプトは実行時に LF 必須
*.sh   text eol=lf
*.bash text eol=lf
