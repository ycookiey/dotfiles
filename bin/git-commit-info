#!/usr/bin/env bash
git status --short
# git-lines is installed separately (cargo); skip it where it is missing.
command -v git-lines >/dev/null && git-lines diff
git diff --cached -U1 --no-prefix --no-color | grep -v '^index '
# Log with body first line + style stats (single git log + awk)
git log -5 --format='%x01%h %s%x02%b' | awk '
BEGIN { RS="\001"; FS="\002"; bc=0; total=0 }
{
  gsub(/^[\r\n]+|[\r\n]+$/, "", $1)
  if ($1 == "") next
  total++
  print $1
  if (NF >= 2) {
    gsub(/^[\r\n]+/, "", $2)
    split($2, lines, /\n/)
    if (lines[1] != "") { print "        " lines[1]; bc++ }
  }
}
END {
  if (bc * 2 >= total) printf "recent-style: body (%d/%d)\n", bc, total
  else printf "recent-style: no-body (%d/%d)\n", total - bc, total
}'

# Safety check: scan added lines only
# Key prefixes only at the start of a word, so task-, risk- and disk- do not
# match (sk-proj-..., sk-ant-... and the like still do).
keywords='TODO|FIXME|console\.log|debugger|api_key|secret|token|password|credential|(^|[^[:alnum:]_])(sk-[A-Za-z0-9]|ghp_|AKIA)'
# The login name finds home paths (C:\Users\<name>, /home/<name>) left in the
# diff. Only a plain name is added: an empty alternative would match every line.
user_name=${USERNAME:-${USER:-${HOME##*/}}}
if [[ $user_name =~ ^[A-Za-z0-9._-]+$ ]]; then
  keywords+="|${user_name//./\\.}"
fi
# GIT_COMMIT_INFO_EXTRA_KEYWORDS: more keywords as an ERE alternation (a|b).
if [[ -n ${GIT_COMMIT_INFO_EXTRA_KEYWORDS:-} ]]; then
  keywords+="|$GIT_COMMIT_INFO_EXTRA_KEYWORDS"
fi
# One awk pass: a per-line `echo | grep` spawns processes per added line and
# took minutes on Git Bash for large diffs. Keywords go through ENVIRON so awk
# does not apply escape processing (-v would turn `\.` into `.`).
git diff HEAD -U0 --no-color 2>/dev/null | KW="$keywords" awk '
  /^\+\+\+/ { next }
  /^\+/ {
    line = substr($0, 2)
    if (match(line, ENVIRON["KW"])) {
      found = substr(line, RSTART, RLENGTH)
      # Drop the character before a key prefix that the match takes along.
      sub(/^[^[:alnum:]_]/, "", found)
      sub(/^[[:space:]]+/, "", line)
      print "WARNING: Found '\''" found "'\'' -> " line
    }
  }'

# Show pre-commit hook (code lines only). --git-path follows core.hooksPath
# (a relative one is taken from the worktree top) and a linked worktree's
# common git dir, and prints a path usable from the current directory.
hook_file=$(git rev-parse --git-path hooks/pre-commit)
if [[ -f "$hook_file" ]]; then
  code_lines=$(grep -Ev '^[[:space:]]*(#|$)' "$hook_file")
  if [[ -n "$code_lines" ]]; then
    echo "--- pre-commit hook ---"
    echo "$code_lines"
  fi
fi
