{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Read(~/.claude/docs/**)",
      "Read(~/.claude-*/docs/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-statusline"
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "model": "claude-opus-5-5",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "language": "日本語",
  "cleanupPeriodDays": 99999,
  "autoMemoryEnabled": false,
  "idleCompaction": false,
  "skipDangerousModePermissionPrompt": true,
  "showClearContextOnPlanAccept": true,
  "wheelScrollAccelerationEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v ysidepaney >/dev/null 2>&1 && ysidepaney register; exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/claude-pid-session.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "yhooky",
            "args": [
              "hook"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "yhooky",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "yhooky",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
