{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Read(~/.claude/docs/**)",
      "Read(~/.claude-*/docs/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-statusline"
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "model": "claude-opus-5-5",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "language": "日本語",
  "cleanupPeriodDays": 99999,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "showClearContextOnPlanAccept": true,
  "wheelScrollAccelerationEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v ysidepaney >/dev/null 2>&1 && ysidepaney register; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/label-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/language-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"$HOME/.claude/hooks/push-check-reminder.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git worktree remove *)",
            "command": "bash \"$HOME/.claude/hooks/worktree-remove-reminder.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(cmd *)",
            "command": "bash \"$HOME/.claude/hooks/cmd-switch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(cmd.exe *)",
            "command": "bash \"$HOME/.claude/hooks/cmd-switch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(timeout *)",
            "command": "bash \"$HOME/.claude/hooks/cmd-switch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(pnpm *)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(npm *)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(yarn *)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(bun *)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(npx *)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(vite)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(vite *)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(wrangler *)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(next *)",
            "command": "bash \"$HOME/.claude/hooks/devserver-launch-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/settings-template-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
