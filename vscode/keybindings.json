[
  {
    "key": "ctrl+enter",
    "command": "-github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated && !inInteractiveInput && !interactiveEditorFocused"
  },
  {
    "key": "ctrl+alt+n",
    "command": "extension.advancedNewFile"
  },
  {
    "key": "ctrl+alt+n",
    "command": "-extension.advancedNewFile"
  },
  {
    "key": "ctrl+k ctrl+alt+n",
    "command": "code-runner.run"
  },
  {
    "key": "ctrl+alt+n",
    "command": "-code-runner.run"
  },
  {
    "key": "ctrl+l",
    "command": "markdowntable.insertLeft",
    "when": "editorFocus && tableMode"
  },
  {
    "key": "ctrl+r",
    "command": "markdowntable.insertRight",
    "when": "editorFocus && tableMode"
  },
  {
    "key": "alt+z",
    "command": "editor.action.toggleWordWrap",
    "when": "editorFocus"
  },
  {
    "key": "alt+z",
    "command": "-editor.action.toggleWordWrap"
  },
  {
    "key": "alt+z",
    "command": "-bracket-select.undo-select",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+m",
    "command": "editor.emmet.action.wrapWithAbbreviation"
  },
  {
    "key": "ctrl+enter",
    "command": "-github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused && !inInteractiveInput && !interactiveEditorFocused"
  },
  {
    "key": "ctrl+k ctrl+r",
    "command": "-workbench.action.keybindingsReference"
  },
  {
    "key": "ctrl+shift+g m",
    "command": "gitlens.generateCommitMessage",
    "when": "editorTextFocus && !gitlens:disabled && config.gitlens.keymap == 'chorded' && gitlens:enabled && !inDebugMode && !isInDiffEditor && resource in 'gitlens:tabs:tracked'"
  },
  {
    "key": "shift+alt+r",
    "command": "revealFileInOS"
  },
  {
    "key": "shift+alt+r",
    "command": "-revealFileInOS",
    "when": "!editorFocus"
  },
  {
    "key": "ctrl+n",
    "command": "-workbench.action.files.newUntitledFile"
  },
  {
    "key": "alt+n",
    "command": "explorer.newFile"
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.files.newUntitledFile"
  },
  {
    "key": "ctrl+alt+c",
    "command": "workbench.view.extension.claude-dev-ActivityBar"
  },
  {
    "key": "ctrl+alt+0",
    "command": "extension.insertSeq",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+oem_period",
    "command": "-extension.insertSeq",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\\\r\n"
    },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+i",
    "command": "-markdown.extension.editing.toggleItalic",
    "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
  },
  {
    "key": "ctrl+shift+w",
    "command": "-workbench.action.closeWindow"
  },
  {
    "key": "ctrl+shift+b",
    "command": "markdown.extension.editing.toggleBold",
    "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
  },
  {
    "key": "ctrl+b",
    "command": "-markdown.extension.editing.toggleBold",
    "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
  },
  {
    "key": "tab",
    "command": "editor.action.inlineSuggest.commit",
    "when": "inlineEditIsVisible && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editor.hasSelection && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editor.hasSelection && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+k ctrl+r",
    "command": "workbench.action.reloadWindow"
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+k ctrl+alt+c",
    "command": "glassit.decrease"
  },
  {
    "key": "ctrl+alt+c",
    "command": "-glassit.decrease"
  },
  {
    "key": "ctrl+k ctrl+alt+z",
    "command": "glassit.increase"
  },
  {
    "key": "ctrl+alt+z",
    "command": "-glassit.increase"
  },
  {
    "key": "ctrl+alt+b",
    "command": "-latex-workshop.build",
    "when": "!config.latex-workshop.bind.altKeymap.enabled && !virtualWorkspace && editorLangId =~ /^build$|^latex$|^latex-class$|^latex-package$|^context$|^latex-expl3$|^doctex$|^rsweave$|^jlweave$|^pweave$/"
  }
]
